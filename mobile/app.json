{
  "expo": {
    "name": "PayNavigate",
    "slug": "paynavigate",
    "version": "1.0.0",
    "scheme": "paynavigate",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F5F3",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jessicaculnane.paynavigate",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jessicaculnane.paynavigate",
      "adaptiveIcon": {
        "backgroundColor": "#1D5C3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of a merchant's card statement so PayNavigate can read its fees.",
          "cameraPermission": "Photograph a merchant's card statement so PayNavigate can read its fees.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F4F5F3"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://ai-payments-consultant-agent-production.up.railway.app",
      "accessKey": ""
    }
  }
}
